# Copy this file to .env and fill in real values. Never commit .env.
#
# Supabase — required. The app will show a "configuration required" screen
# instead of attempting to connect anywhere until both of these are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map tiles / geocoding (RoutePlanner, MyTrips, TripDetailModal).
VITE_MAPBOX_TOKEN=
VITE_ORS_API_KEY=

# Web push (NotificationBell). Public key is used client-side; the matching
# private key is a server-only secret used by api/send-push.js and must be
# set in the deployment platform's environment settings, not in this file.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
